{
    "name": "phpnitro/firebase",
    "description": "PhpNitro's Firebase package — a Firebase Auth REST client (Engine\\Firebase\\*), no Firebase SDK dependency.",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Engine\\Firebase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Engine\\Firebase\\Tests\\": "tests/"
        }
    }
}
